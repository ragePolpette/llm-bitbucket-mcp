# Atlassian account email (not a secret, fine in .env)
BITBUCKET_USER_EMAIL=

# Runtime secrets are intentionally excluded from this file.
# Provide BITBUCKET_API_TOKEN and, if needed, MCP_BB_INTERNAL_API_KEY only through the process environment:
# - exported in the shell that starts the server
# - or injected by whatever launcher starts the process

# Multi-repository registry. IDs are the selectors used by MCP tools (repository_id).
# allowMerge (default false) enables merge_pull_request for that repository, always with a two-step confirmation.
BITBUCKET_REPOSITORIES_JSON=[{"id":"backend","displayName":"Backend","workspace":"workspace-slug","repoSlug":"repo-slug","defaultDestinationBranch":"main","status":"active","allowMerge":false}]
BITBUCKET_DEFAULT_REPOSITORY=backend
# Legacy single-repository configuration: used when the registry is not set (creates the "default" repository).
# BITBUCKET_WORKSPACE=workspace-slug
# BITBUCKET_REPO_SLUG=repo-slug
# BITBUCKET_DEFAULT_DESTINATION_BRANCH=
# BITBUCKET_ALLOW_MERGE=false
MCP_BB_HOST=127.0.0.1
MCP_BB_PORT=8783
MCP_BB_PATH=/mcp
MCP_BB_SSE_ENABLED=false
# Default session TTL: 30 minutes
MCP_BB_SESSION_TTL_MS=1800000
MCP_BB_MAX_SESSIONS=100
MCP_BB_RETRY_MAX_ATTEMPTS=3
MCP_BB_RETRY_BASE_DELAY_MS=250
# Optional comma-separated list of enabled write tools
MCP_BB_ENABLED_WRITE_TOOLS=add_pull_request_comment,create_pull_request,open_pull_request,run_pipeline,merge_pull_request
MCP_BB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_BB_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
