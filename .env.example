# Email dell'account Atlassian (non secret, ok nel .env)
BITBUCKET_USER_EMAIL=

# I secret runtime sono intenzionalmente esclusi da questo file.
# Passa BITBUCKET_API_TOKEN e, se serve, MCP_BB_INTERNAL_API_KEY solo al runtime:
# - al lancio del file .ps1
# - oppure dalla dashboard MCP locale

# Registry multi-repository. Gli ID sono i selector usati dai tool MCP.
# allowMerge (default false) abilita merge_pull_request per quel repository, sempre con conferma a due passi.
BITBUCKET_REPOSITORIES_JSON=[{"id":"backend","displayName":"Backend","workspace":"workspace-slug","repoSlug":"repo-slug","defaultDestinationBranch":"main","status":"active","allowMerge":false}]
BITBUCKET_DEFAULT_REPOSITORY=backend
# Compatibilità legacy: se il registry non è impostato viene creato il repository "default".
# BITBUCKET_WORKSPACE=studioboost
# BITBUCKET_REPO_SLUG=bpopilot
# BITBUCKET_DEFAULT_DESTINATION_BRANCH=
# BITBUCKET_ALLOW_MERGE=false
MCP_BB_HOST=127.0.0.1
MCP_BB_PORT=8783
MCP_BB_PATH=/mcp
MCP_BB_SSE_ENABLED=false
# Session TTL default consigliato: 30 minuti
MCP_BB_SESSION_TTL_MS=1800000
MCP_BB_MAX_SESSIONS=100
MCP_BB_RETRY_MAX_ATTEMPTS=3
MCP_BB_RETRY_BASE_DELAY_MS=250
# Lista opzionale di tool write abilitati, separati da virgola
MCP_BB_ENABLED_WRITE_TOOLS=add_pull_request_comment,create_pull_request,open_pull_request,run_pipeline,merge_pull_request
MCP_BB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_BB_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
