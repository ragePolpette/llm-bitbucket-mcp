# Email dell'account Atlassian (non secret, ok nel .env)
BITBUCKET_USER_EMAIL=

# API Token Atlassian — NON inserire qui!
# Deve essere fornito a runtime (dalla dashboard o come env var).
# Il server rifiutera' di avviarsi se trova BITBUCKET_API_TOKEN nel .env.
# BITBUCKET_API_TOKEN=

BITBUCKET_WORKSPACE=studioboost
BITBUCKET_REPO_SLUG=bpopilot
BITBUCKET_DEFAULT_DESTINATION_BRANCH=
MCP_BB_HOST=127.0.0.1
MCP_BB_PORT=8783
MCP_BB_PATH=/mcp
MCP_BB_SSE_ENABLED=false
MCP_BB_SESSION_TTL_MS=0
MCP_BB_CLONE_ROOT=
MCP_BB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_BB_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
