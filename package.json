{
    "name": "llm-bitbucket-mcp",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "MCP server for Bitbucket Cloud — semantic PR tools + generic API escape hatch, with dashboard logging.",
    "engines": {
        "node": ">=22 <23"
    },
    "scripts": {
        "check": "npm run lint && npm run format:check && npm test",
        "docker:build": "docker build -t llm-bitbucket-mcp:local .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "release:check": "npm run check",
        "start": "node src/server.js",
        "test": "node --import ./scripts/test-env.js --test"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.1.0",
        "globals": "^17.4.0",
        "prettier": "^3.8.1"
    }
}
